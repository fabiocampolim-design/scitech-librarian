# TEMPLATE ONLY -- this file is COMMITTED to git. Never put real keys here.
#
# The tool reads these keys from the process environment. Two equally good ways
# to get them there:
#   .env  -- copy this file to `.env` (gitignored) and fill that one in;
#            librarian.py loads it automatically, no shell fiddling needed.
#   env   -- export them in your shell, set them in your agent's or launcher's
#            configuration, or supply them as CI secrets. These win: `.env`
#            only fills in what is unset, so you may never need a `.env` at all.

# --- contact address (recommended for everyone) --------------------------
# Used for the OpenAlex / Crossref / Unpaywall "polite pools" (faster, more
# reliable rate limits) and required by Unpaywall. Not a secret.
CONTACT_EMAIL=

# --- OpenAlex (optional) ---------------------------------------------------
# Works without a key but has a daily free request budget (resets at midnight
# UTC). A free key -- and prepaid credits -- raise it: https://openalex.org/pricing
OPENALEX_API_KEY=

# --- NASA ADS ----------------------------------------------------------
# Free, 30 seconds: https://ui.adsabs.harvard.edu/user/settings/token
# Excellent physics coverage; indexes arXiv + published versions together.
ADS_TOKEN=

# --- Scopus / Elsevier -------------------------------------------------
# Free key: https://dev.elsevier.com/apikey/manage
# The key authenticates YOU; entitlement comes from your institution's
# subscription, so you must be on the campus network or your institution's VPN.
# Elsevier has no revoke button -- old keys stay live. Treat a leaked key as
# burned rather than disabled.
SCOPUS_API_KEY=

# Optional. Lets Scopus work from anywhere without VPN. Your library requests
# it from Elsevier; it is issued per institution.
SCOPUS_INSTTOKEN=

# --- Semantic Scholar (optional) -------------------------------------------
# Works keyless at ~1 req/s, which is fine at this tool's volume. A key
# (https://www.semanticscholar.org/product/api) raises the rate limit.
S2_API_KEY=

# --- Web of Science (optional, rarely worth it) -----------------------------
# Free Starter key: https://developer.clarivate.com
# The Starter tier has a restricted query grammar. The full TS=/NEAR grammar
# needs the Expanded API, licensed separately and usually not part of a
# national or institutional consortium deal. If unavailable, run WoS by hand
# with wos_manual.py.
WOS_STARTER_KEY=

# --- CORE (optional; the backend works without it) --------------------------
# CORE answers anonymous callers but rate-limits them; a free key raises the
# ceiling. Free key: https://core.ac.uk/services/api
CORE_API_KEY=
