# TEMPLATE ONLY -- this file is COMMITTED to git. Never put real keys here.
# Copy to `.env` (which is gitignored) and fill that one in.
# litscan.py loads `.env` automatically -- no shell environment fiddling needed.

# --- Scopus / Elsevier -------------------------------------------------
# Free key: https://dev.elsevier.com/apikey/manage
# The key authenticates YOU; entitlement comes from Unicamp's subscription,
# so you must be on the campus network or the Unicamp VPN.
# Elsevier has no revoke button -- old keys stay live. Treat them as burned
# rather than disabled if exposed.
SCOPUS_API_KEY=

# Optional. Lets Scopus work from anywhere without VPN. Request from
# Elsevier support via SBU; they issue it per institution.
SCOPUS_INSTTOKEN=

# --- Web of Science ----------------------------------------------------
# Free Starter key: https://developer.clarivate.com
# Starter tier has a restricted query grammar -- the NEAR/n queries will fail.
# Full TS=/NEAR needs the Expanded API, licensed separately and NOT in the
# CAPES subscription. If unavailable, run WoS manually in the web UI.
WOS_STARTER_KEY=

# --- NASA ADS ----------------------------------------------------------
# Free, 30 seconds: https://ui.adsabs.harvard.edu/user/settings/token
# Excellent physics coverage; indexes arXiv + published versions together.
ADS_TOKEN=

# --- Semantic Scholar --------------------------------------------------
# No key needed. The backend runs keyless at ~1 req/s, which is fine at our
# volume, so S2_API_KEY has been dropped from this config entirely.

# --- contact address ---------------------------------------------------
# Used for the OpenAlex / Crossref / Unpaywall "polite pools" (faster, more
# reliable rate limits). Not a secret -- these APIs require it, not a key.
CONTACT_EMAIL=
