# Real credentials -- NEVER commit. Elsevier keys cannot be revoked;
# a committed key is burned forever. Copy .env.example to .env and fill it.
.env

# Your real research queries (the repo ships queries.example.json only --
# your query blocks can reveal unpublished research directions)
queries*.json
!queries.example.json

# All run output -- every research directory, whatever it is called
lit/
lit*/
manual_wos/
# Exports and licensed downloads you may drop next to the scripts
/*.ris
/*.bib
JCR_*.csv
scimagojr*.csv

# Python
__pycache__/
*.pyc
.pytest_cache/

# Claude Code per-machine permissions
.claude/settings.local.json
